{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lowelltwong-alt.github.io/schemas/release-receipt.schema.json",
  "oneOf": [
    {
      "$ref": "#/$defs/candidate"
    },
    {
      "$ref": "#/$defs/final"
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schema_version",
        "receipt_id",
        "status",
        "observed_at",
        "public_inventory_count",
        "evidence_class",
        "public_safety",
        "release_authorized",
        "non_claims"
      ],
      "properties": {
        "$schema": {
          "const": "../schemas/release-receipt.schema.json"
        },
        "schema_version": {
          "const": "2.0.0"
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "status": {
          "const": "content_candidate_public_safe"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "public_inventory_count": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_class": {
          "const": "generated_secondary"
        },
        "public_safety": {
          "const": "public_safe_candidate"
        },
        "release_authorized": {
          "const": false
        },
        "non_claims": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "final": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "$schema",
        "schema_version",
        "receipt_id",
        "status",
        "observed_at",
        "public_inventory_count",
        "evidence_class",
        "public_safety",
        "release_authorized",
        "non_claims",
        "content_pr",
        "source_shas",
        "public_checks",
        "inventory_observation",
        "privacy_result",
        "lane_dispositions"
      ],
      "properties": {
        "$schema": {
          "const": "../schemas/release-receipt.schema.json"
        },
        "schema_version": {
          "const": "2.0.0"
        },
        "receipt_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "status": {
          "const": "final_closure_public_safe"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "public_inventory_count": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_class": {
          "const": "generated_secondary"
        },
        "public_safety": {
          "const": "public_safe_closure"
        },
        "release_authorized": {
          "const": false
        },
        "non_claims": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "content_pr": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "number",
            "merged_sha",
            "merged_at",
            "method"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "merged_sha": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "merged_at": {
              "type": "string",
              "format": "date-time"
            },
            "method": {
              "enum": [
                "merge",
                "squash",
                "rebase"
              ]
            }
          }
        },
        "source_shas": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["repo","sha","observed_at","access"],"properties":{"repo":{"type":"string"},"sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"observed_at":{"type":"string","format":"date-time"},"access":{"const":"anonymous_public"}}}},
        "public_checks": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name","status","observed_at","public_url","non_claims"],"properties":{"name":{"type":"string"},"status":{"enum":["pass","not_applicable"]},"observed_at":{"type":"string","format":"date-time"},"public_url":{"oneOf":[{"type":"string","format":"uri"},{"const":"not_applicable"}]},"non_claims":{"type":"array","minItems":1,"items":{"type":"string"}}}}},
        "inventory_observation": {"type":"object","additionalProperties":false,"required":["source_url","observed_at","count","access"],"properties":{"source_url":{"type":"string","format":"uri"},"observed_at":{"type":"string","format":"date-time"},"count":{"type":"integer","minimum":1},"access":{"const":"anonymous_public"}}},
        "privacy_result": {"type":"object","additionalProperties":false,"required":["status","observed_at","sole_private_disclosure","non_claims"],"properties":{"status":{"const":"pass"},"observed_at":{"type":"string","format":"date-time"},"sole_private_disclosure":{"const":"Digital Asset Directory"},"non_claims":{"type":"array","minItems":1,"items":{"type":"string"}}}},
        "lane_dispositions": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["public_lane_label","status","public_sha","reason","non_claims"],"properties":{"public_lane_label":{"type":"string"},"status":{"enum":["integrated","blocked","held","unpublished"]},"public_sha":{"oneOf":[{"type":"string","pattern":"^[0-9a-f]{40}$"},{"const":"not_published"}]},"reason":{"type":"string"},"non_claims":{"type":"array","minItems":1,"items":{"type":"string"}}}}}
      }
    }
  }
}
